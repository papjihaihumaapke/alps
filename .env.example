# Copy this file to .env.local for local development, and set the same values
# in your Vercel project (Settings -> Environment Variables) for deployment.
#
# Public (safe to expose to the browser / commit): the VITE_* and anon keys.
# Already provided in the committed .env, listed here for completeness.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# Server-side runtime values (read via process.env in SSR / server functions).
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"

# SECRET — never commit. Required by the /admin server functions (bypasses RLS).
# Supabase: Project Settings -> API -> service_role secret.
# Put the real value in .env.local locally and in the Vercel dashboard for prod.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"
